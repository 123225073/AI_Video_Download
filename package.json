{
  "name": "fengsha-video-downloader",
  "version": "0.8.12",
  "description": "风沙全平台视频下载器：链接识别、批量下载与本地媒体管理",
  "private": true,
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "author": "Fengsha",
  "license": "UNLICENSED",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "node scripts/prepare-collector.mjs && node scripts/prepare-cli.mjs && vite build",
    "start": "node scripts/start.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "node --check electron/main.js && node --check electron/engine.js && node --check electron/queue.js && node --check electron/store.js && node --check electron/wechat.js && vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "dist": "node scripts/package.mjs",
    "test:manuscript": "node scripts/manuscript-e2e.mjs",
    "test:settings": "node scripts/settings-e2e.mjs",
    "cli": "node cli/fengsha.mjs",
    "test:cli": "node scripts/cli-e2e.mjs",
    "test:content": "node scripts/content-e2e.mjs",
    "test:voice": "node scripts/voice-e2e.mjs",
    "test:navigation": "node scripts/content-navigation-e2e.mjs",
    "test:stream": "node scripts/content-stream-e2e.mjs",
    "test:studio": "node scripts/studio-stream-e2e.mjs",
    "test:comments": "node scripts/comments-stream-e2e.mjs",
    "test:contacts": "node scripts/comments-contact-e2e.mjs",
    "test:comparison": "node scripts/studio-compare-e2e.mjs",
    "test:studio-races": "node scripts/studio-races-e2e.mjs",
    "test:preview": "node scripts/media-preview-e2e.mjs",
    "test:creative": "node scripts/video-creative-086-e2e.mjs",
    "test:studio-transcription": "node scripts/studio-transcription-e2e.mjs",
    "test:stability": "node scripts/video-stability-087-e2e.mjs",
    "test:records": "node scripts/records-088-e2e.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "sql.js": "^1.13.0",
    "zod": "^4.1.0",
    "opencc-js": "1.0.5"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.55.0"
  },
  "build": {
    "appId": "online.fengsha.video-downloader",
    "productName": "风沙全平台视频下载器",
    "artifactName": "FengshaVideoDownloader-${version}-setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "cli/**/*",
      "skills/xiaohongshu-remix/SKILL.md"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!yt-dlp-new.exe",
          "!yt-dlp-checksums.txt"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "docs/使用说明.md",
        "to": "使用说明.md"
      },
      {
        "to": "cli",
        "filter": [
          "**/*",
          "!fengsha-cli.cmd"
        ],
        "from": "cli"
      },
      {
        "from": "docs/images",
        "to": "images"
      },
      {
        "from": "docs/CLI使用说明.md",
        "to": "CLI使用说明.md"
      },
      {
        "from": "docs/用户搜索.md",
        "to": "用户搜索.md"
      },
      {
        "from": "docs/安装部署.md",
        "to": "安装部署.md"
      },
      {
        "from": "docs/网络代理共存方案.md",
        "to": "网络代理共存方案.md"
      },
      {
        "from": "docs/微信分流-审阅片段.yaml",
        "to": "微信分流-审阅片段.yaml"
      },
      {
        "from": "docs/作品二创与评论采集.md",
        "to": "作品二创与评论采集.md"
      },
      {
        "from": "docs/视频创作续接与批量配图-0.8.6.md",
        "to": "视频创作续接与批量配图-0.8.6.md"
      },
      {
        "from": "docs/图文自动恢复说明-0.8.7.md",
        "to": "图文自动恢复说明-0.8.7.md"
      },
      {
        "from": "docs/记录删除与评论实测-0.8.8.md",
        "to": "记录删除与评论实测-0.8.8.md"
      },
      {
        "from": "docs/Chrome登录与采集修复-0.8.9.md",
        "to": "Chrome登录与采集修复-0.8.9.md"
      },
      {
        "from": "docs/博主视频二创修复-0.8.10.md",
        "to": "博主视频二创修复-0.8.10.md"
      },
      {
        "from": "docs/稳定性与自动部署-0.8.11.md",
        "to": "稳定性与自动部署-0.8.11.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "FengshaVideoDownloader",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "风沙全平台视频下载器",
      "deleteAppDataOnUninstall": false
    },
    "extraFiles": [
      {
        "from": "cli/fengsha-cli.cmd",
        "to": "fengsha-cli.cmd"
      }
    ]
  }
}
